# このファイルをコピーして .env.local を作り、キーを書いてください。
#   cp .env.example .env.local
# .env.local は git に入りません。キーをチャットやリポジトリに貼らないでください。

# 雑談の返事を作るのに使います（https://console.anthropic.com/ で発行）
ANTHROPIC_API_KEY=

# PC で動かしている AivisSpeech Engine の場所。
# 既定のまま使うなら書かなくてかまいません。
# AIVIS_ENGINE_URL=http://127.0.0.1:10101

# 生徒名簿を Supabase から読む場合だけ書きます。
# 書かなければ、設定画面から取り込んだ端末の名簿を使います。
# 鍵はこのサーバーの中だけで使い、ブラウザには渡りません。
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_KEY=
# SUPABASE_STUDENTS_TABLE=students
